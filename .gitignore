# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets cục bộ — không commit
.env
.env.*
!.env.example

# CSDL nguồn sự thật là PostgreSQL (AGENTS.md mục 2) — không có .db nào trong repo
# là source hợp lệ, toàn bộ *.db từng thấy đều là SQLite rác (scaffold v1 hoặc
# runtime state của Dagster) nên ignore rộng theo phần mở rộng là an toàn.
*.db
logs/*.log

# Dagster runtime home tạm (DAGSTER_HOME mặc định khi không set env) — state chạy,
# không phải source.
.tmp_dagster_home*/
dagster_home/

# dbt (task 0.10) — artifact sinh ra khi chạy, không phải source
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
dbt_project/.user.yml

# git worktree cục bộ trỏ nhánh gh-pages (task 1.10, §12.1) — trung gian đồng bộ
# docs-site/ sang nhánh serve GitHub Pages, không phải source, không commit trên main.
.gh-pages-worktree/
