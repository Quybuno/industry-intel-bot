DATABASE_URL=postgresql+psycopg://intel:intel@localhost:5435/intel_bot
POSTGRES_USER=intel
POSTGRES_PASSWORD=intel
POSTGRES_DB=intel_bot
# 5435, không phải 5432 mặc định: máy dev có thể đã có Postgres native chiếm 5432-5434.
POSTGRES_PORT=5435
OLLAMA_BASE_URL=http://localhost:11434
GITHUB_TOKEN=
OPENAI_API_KEY=
# Provider chấm điểm thật của pipeline (config/models.yaml: providers.deepseek). Lấy tại
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Dùng riêng cho agent (Claude Code) khi tóm lược tài liệu ở "fast mode" — không phải
# provider của pipeline scoring/summary (xem config/models.yaml cho việc đó).
GEMINI_API_KEY=
GIT_PUBLISH_TOKEN=
SLACK_WEBHOOK_URL=
LOG_LEVEL=INFO
# Dagster resource "llm" (task 0.12) — mock|deepseek, BẮT BUỘC (dagster_project/resources/llm.py
# raise Failure rõ ràng nếu thiếu/sai, không default ngầm về mock — xem lý do ở đó).
LLM_PROVIDER=mock
# Dead-man's-switch bên ngoài (PRODUCTION_PLAN §7.5, task 0.13) — URL dạng
# https://hc-ping.com/<uuid> từ healthchecks.io (free tier) hoặc dịch vụ tương đương. Rỗng
# thì asset published_site chỉ log warning, không fail (rào chắn task 0.13 mục 7).
HEARTBEAT_URL=
